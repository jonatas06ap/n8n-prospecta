# =============================================================================
# Painel Streamlit (leads-dashboard) — copie para .env e preencha:
#   cp .env.example .env
# Template agregado na raiz: ../../.env.example
# =============================================================================

# Login do painel (APP_PASSWORD obrigatório para o app arrancar)
APP_USER=admin
APP_PASSWORD=troque-esta-senha

# -----------------------------------------------------------------------------
# Postgres — prioridade: DATABASE_URL ou POSTGRES_URL (mesmo formato)
# -----------------------------------------------------------------------------
# Supabase: Dashboard → Connect → PSQL → Session pooler (IPv4 / Docker).
#   Utilizador: postgres.<PROJECT_REF>
#   Host:       aws-0-<REGIAO>.pooler.supabase.com
#   Porta:      a indicada no modal (muitas vezes 5432)
#   Base:       postgres
#
# Descomente e preencha (substitua SENHA; se tiver @ # etc., codifique na URI ou use variáveis POSTGRES_* abaixo):
#
# DATABASE_URL=postgresql://postgres.wuntfeozkbqieivojqrt:SUA_SENHA@aws-0-us-west-1.pooler.supabase.com:5432/postgres?sslmode=require
#
# O app aceita também POSTGRES_URL= (mesmo formato que DATABASE_URL).
#
# Ligação direta (alternativa): postgresql://postgres:SENHA@db.<REF>.supabase.co:5432/postgres?sslmode=require
#
# Se DATABASE_URL e POSTGRES_URL estiverem vazias, usa-se:
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=troque-a-senha
POSTGRES_SSLMODE=require

# Tabela onde estão os leads (nome simples, schema public)
POSTGRES_LEADS_TABLE=leads

# -----------------------------------------------------------------------------
# Webhooks n8n — POST JSON, sem autenticação
# -----------------------------------------------------------------------------
# Serper + CNPJ.ws  → típico /webhook/forms_maps
WEBHOOK_SERPER_CNPJ=http://192.168.200.113:5678/webhook/forms_maps
# Places API       → típico /webhook/forms_cnpj
WEBHOOK_PLACES=http://192.168.200.113:5678/webhook/forms_cnpj
#
# Streamlit em Docker a falar com n8n no host: http://host.docker.internal:5678/... (Linux: ver docker-compose extra_hosts)
